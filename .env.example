# ---------- App ----------
NEXT_PUBLIC_APP_NAME=MindGuide AI
# Your live address, e.g. https://www.yourdomain.com (used in emails and payment links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase (Project Settings → API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret – server only, never share
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Paystack (Settings → API Keys & Webhooks) ----------
# Demo only: set to true (and leave PAYSTACK_SECRET_KEY empty) to activate plans without payment.
DEMO_PAYMENTS=false
PAYSTACK_SECRET_KEY=sk_test_xxx
# Plan codes from Paystack → Products → Plans (monthly). Leave blank to take one-off monthly payments instead.
PAYSTACK_PLAN_BASIC=
PAYSTACK_PLAN_STANDARD=
PAYSTACK_PLAN_PREMIUM=
PAYSTACK_PLAN_FAMILY=

# ---------- AI assessment (console.anthropic.com) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---------- Email (resend.com) ----------
RESEND_API_KEY=
EMAIL_FROM=MindGuide AI <hello@yourdomain.com>
# Gets an email whenever an assessment is flagged high-risk
ADMIN_ALERT_EMAIL=

# ---------- SMS (termii.com) ----------
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com

# ---------- Video and voice calls (built-in) ----------
# Calls connect directly between the two devices. A TURN server relays the call when a mobile network
# blocks direct connections. Comma-separate several URLs. Leave empty to use free STUN only (fine for testing).
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---------- Reminders cron ----------
# Any long random string. The scheduler must send it as "Authorization: Bearer <value>" or ?secret=<value>
CRON_SECRET=

# ---------- MindGuide Assistant (website chat + WhatsApp) ----------
# Uses ANTHROPIC_API_KEY above. Without it, the assistant answers from a built-in FAQ.
# Websites allowed to call /api/assistant (comma-separated). * allows any.
# The official website's address (used in event emails and "View on website" links)
NEXT_PUBLIC_WEBSITE_URL=https://www.mindguideailtd.com
# Sites allowed to use the assistant, events and gallery APIs from the browser (comma-separated)
ASSISTANT_ALLOWED_ORIGINS=*
# WhatsApp Cloud API (Meta for Developers → your app → WhatsApp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any long random string; enter the same value in Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
# Approved message templates for reminders and weekly check-ins (see src/lib/whatsapp.ts for the wording)
WHATSAPP_TEMPLATE_REMINDER=session_reminder
WHATSAPP_TEMPLATE_CHECKIN=weekly_checkin
WHATSAPP_TEMPLATE_LANG=en

# Phone and computer alerts (web push). Generate a pair once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mindguideai@gmail.com
